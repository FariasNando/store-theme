{
  "store.custom#assistencia": {
    "blocks": [
      "info-card#technical-assistance",
      "flex-layout.row#technical-assistance",
      "flex-layout.row#technical-assistance-catalog",
      "flex-layout.row#technical-assistance-contact"
    ]
  },
  "flex-layout.row#technical-assistance": {
    "title": "Assistência Técnica",
    "children": [
      "rich-text#technical-assistance",
      "technical-assistance"
    ],
    "props": {
      "blockClass": "technical-assistance",
      "fullWidth": true,
      "preventHorizontalStretch": true
    }
  },
  "info-card#technical-assistance": {
    "props": {
      "id": "info-card#technical-assistance",
      "isFullModeStyle": true,
      "textPosition": "center",
      "imageUrl": "assets/images/banner.webp",
      "mobileImageUrl": "assets/images/banner-mobile.webp",
      "headline": "PROCURE UMA ASSISTÊNCIA TÉCNICA AUTORIZADA FRANKE",
      "bodyText": "Para garantir que você tenha um atendimento pós-venda com o máximo de excelência, oferecemos uma ampla rede de Assistências Técnicas Autorizadas.",
      "blockClass": "info-card-tec",
      "textAlignment": "center",
      "fetchpriority": "auto",
      "callToActionMode": "none",
      "preload": true
    }
  },
  "rich-text#technical-assistance": {
    "props": {
      "id": "rich-text#technical-assistance",
      "text": "Selecione o produto que necessita de assistencia:",
      "textAlignment": "CENTER",
      "blockClass": "rich-text-tec"
    }
  },
  "flex-layout.row#technical-assistance-catalog": {
    "title": "Catálogo de Assistências Autorizadas",
    "children": [
      "rich-text#catalog-title",
      "rich-text#catalog-download"
    ],
    "props": {
      "blockClass": "technical-assistance-catalog",
      "fullWidth": true,
      "preventHorizontalStretch": true
    }
  },
  "rich-text#catalog-title": {
    "props": {
      "text": "Se preferir, faça o download do nosso catálogo de Assistências Autorizadas:",
      "textAlignment": "CENTER",
      "blockClass": "rich-text-catalog"
    }
  },
  "rich-text#catalog-download": {
    "props": {
      "text": "<a class='download' href='https://drive.google.com/uc?export=download&id=1DThFcBwmd1JdLu-DcaGeTKkhAYJE1P9E' download target='_blank'>Baixar catálogo de Assistências Autorizadas Franke</a>",
      "textAlignment": "CENTER",
      "blockClass": "catalog-download"
    }
  },
  "flex-layout.row#technical-assistance-contact": {
    "title": "Contato",
    "children": [
      "flex-layout.col#contact"
    ],
    "props": {
      "blockClass": "technical-assistance-contact",
      "fullWidth": true
    }
  },
  "flex-layout.col#contact": {
    "children": [
      "rich-text#contact-title",
      "flex-layout.row#phones",
      "flex-layout.row#email",
      "flex-layout.row#opening-hours"
    ],
    "props": {
      "blockClass": "contact-col"
    }
  },
  "rich-text#contact-title": {
    "props": {
      "text": "Fale com a Franke:",
      "textAlignment": "CENTER",
      "blockClass": "rich-text-contact"
    }
  },
  "flex-layout.row#phones": {
    "children": [
      "rich-text#phone1",
      "rich-text#phone2"
    ],
    "props": {
      "blockClass": "phones-row"
    }
  },
  "rich-text#phone1": {
    "props": {
      "text": "<a href='https://wa.me/47991698550' target='_blank'>47 99169 8550</a>",
      "textAlignment": "CENTER",
      "blockClass": [
        "phone-text",
        "phone-text-whatsapp"
      ]
    }
  },
  "rich-text#phone2": {
    "props": {
      "text": "<a href='tel:+08004773000' target='_blank'>0800 477 3000</a>",
      "textAlignment": "CENTER",
      "blockClass": [
        "phone-text",
        "phone-text-phone"
      ]
    }
  },
  "flex-layout.row#email": {
    "children": [
      "rich-text#email"
    ],
    "props": {
      "blockClass": "email-row"
    }
  },
  "rich-text#email": {
    "props": {
      "blockClass": "email-text",
      "text": "<a href='mailto:franke-atendimento@franke.com'>franke-atendimento@franke.com</a>"
    }
  },
  "flex-layout.row#opening-hours": {
    "children": [
      "flex-layout.col#oppening-hours"
    ],
    "props": {
      "blockClass": "opening-hours-row"
    }
  },
  "flex-layout.col#oppening-hours": {
    "children": [
      "rich-text#opening-hours-title",
      "rich-text#opening-hours"
    ],
    "props": {
      "blockClass": "opening-hours-col"
    }
  },
  "rich-text#opening-hours-title": {
    "props": {
      "text": "Horário de Atendimento:",
      "textAlignment": "CENTER",
      "blockClass": "opening-hours-title"
    }
  },
  "rich-text#opening-hours": {
    "props": {
      "text": "Segunda à quinta-feira - 8h às 17h30 <br>Sexta - 8h às 16h30",
      "textAlignment": "CENTER",
      "blockClass": "opening-hours-text"
    }
  }
}
